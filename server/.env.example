# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/botfrag
# Long random string used to sign login tokens. Required in production.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
PORT=5000
# Where uploaded images and clips are stored (relative to server/)
UPLOAD_DIR=uploads
# The address people open the site at. OAuth redirect URLs are built from it.
# Dev default: http://localhost:5173. Set it to your real domain in production.
PUBLIC_URL=http://localhost:5173
# Dev only: the Vite dev server origin allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Optional: IGDB game data (covers, genres, release dates, game search).
# Create an app at https://dev.twitch.tv/console/apps (needs 2FA on your Twitch account),
# then copy its Client ID and a Client Secret here. Leave empty to run without IGDB.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optional: "Sign in with Discord". Create an app at https://discord.com/developers/applications,
# add the redirect <PUBLIC_URL>/api/auth/discord/callback under OAuth2, and copy its keys here.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional: "Sign in with Twitch". Defaults to the IGDB keys above (same Twitch app); add the
# redirect <PUBLIC_URL>/api/auth/twitch/callback to that app. Set these only to use a different app.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
